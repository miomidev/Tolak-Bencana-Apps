<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_color</item>
        <!-- Transparent icon: the TB logo is shown once by Flutter. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/transparent_splash_icon</item>
        <!-- Keep the window green between the system splash and Flutter's first frame. -->
        <item name="android:windowBackground">@color/splash_color</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_color</item>
    </style>
</resources>
